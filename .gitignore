node_modules/
dist/
output/
_archive/
.DS_Store
packages/web/dist/
test_output/

# tsc output that lands next to sources (outDir is dist/, but stray builds
# happen). Deliberately NOT bare `*.js` — that silently blocked committing
# root-level JS tooling configs like eslint.config.js for months.
packages/api/src/**/*.js
packages/api/src/**/*.d.ts
packages/api/src/**/*.js.map
packages/api/scripts/**/*.js

# Netlify CLI local state (contains siteId; regenerated by `netlify link`)
.netlify/

# Environment secrets (template is committed, real file is per-deploy)
packages/api/.env.production

# Supabase CLI session state — never commit, regenerated on `supabase link`
packages/api/supabase/.temp/

# Playwright
packages/web/test-results/
packages/web/playwright-report/
packages/web/blob-report/

# packages/shared emits declarations only; runtime resolves src/ directly
packages/shared/dist/
