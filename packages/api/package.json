{
  "name": "@taxengine/api",
  "version": "0.1.0",
  "description": "IRS tax computation engine, PDF form filler, and MCP server",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx --unhandled-rejections=warn src/server.ts",
    "verify": "tsx scripts/verify_pipeline.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "tsc -p ../shared",
    "lint": "eslint src scripts",
    "build:worker": "bash scripts/build_worker.sh"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1033.0",
    "@aws-sdk/client-lambda": "^3.1121.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/client-ssm": "^3.1121.0",
    "@aws-sdk/client-textract": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@supabase/supabase-js": "^2.103.0",
    "@taxengine/shared": "*",
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "pdf-lib": "^1.17.1",
    "uuid": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
