# Template for packages/api/.env.production (gitignored). In production most of
# these live in AWS SSM Parameter Store under /tax-api/* and are loaded by
# scripts/load-ssm-env.sh — this file is the reference for what exists.
# NEVER commit real values. See packages/api/CLAUDE.md for the load order.

# ── Server ──
PORT=3737
NODE_ENV=production
# Comma-separated static API keys. No default — leave unset to require
# Supabase JWTs / provisioned api_key rows only.
TAX_API_KEYS=

# ── Supabase ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Encryption (KMS envelope; see src/lib/crypto.ts) ──
TAX_API_KMS_KEY=
TAX_API_BLIND_HMAC=
TAX_API_DEK_TTL_MS=
TAX_API_DEK_CACHE_MAX=
# Rollback-only safety valve — leave unset (see src/lib/row_crypto.ts)
TAX_API_WRITE_PLAINTEXT=

# ── AWS (S3 uploads, Textract via boto3 subprocess, KMS, SSM) ──
AWS_REGION=us-east-1
S3_BUCKET=

# ── QuickBooks Online OAuth ──
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=production

# ── Gemini (document classification, gap fill, scenario analysis) ──
GEMINI_API_KEY=

# ── URLs / OAuth discovery ──
API_BASE_URL=
APP_URL=
OAUTH_AUTH_SERVER_URL=
OAUTH_PROTECTED_RESOURCE=
OAUTH_RESOURCE_ORIGIN=

# ── Misc ──
GITHUB_WEBHOOK_SECRET=
PYTHON_BIN=
# Optional override for which dotenv file bootstrap_env.ts loads
DOTENV_CONFIG_PATH=
