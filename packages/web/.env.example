# Copy to .env for local dev. There are deliberately no fallback literals in
# the code any more (the old hardcoded anon key had to be rotated).
# Prod builds get these from the Netlify dashboard (Site settings → Environment
# variables); netlify.toml names only the non-secret ones.
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
